# Supabase Postgres — REQUIRED for local dev (same DB as Render).
# Supabase → Connect → copy URI (Session pooler 5432 or Transaction 6543).
# Local ./scripts/dev.sh and Render both read this file → one shared database.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# SQLite sandbox only: LOCAL_USE_SQLITE=1 ./scripts/dev.sh (does NOT update Render data)
DB_PATH=data/football.db

# API-Football v3 — https://www.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# football-data.org — https://www.football-data.org/
FOOTBALL_DATA_KEY=your_football_data_key_here

# Without API keys: python scripts/feed_data.py  or  POST /seed
LEAGUE_ID=1
SEASON=2026
FOOTBALL_DATA_COMPETITION_ID=2000

# Render sets true. Local: false avoids duplicate cron if Render is also running.
# Manual "Run full pipeline" on Monitor works regardless of this flag.
# Keep false unless you want background sync on this instance (admin pipeline is enough for most use).
ENABLE_SCHEDULER=false

# --- Local development (same data as Render, no deploy wait) ---
# 1. cp .env.example .env — paste DATABASE_URL + keys from Render dashboard
# 2. ./scripts/dev.sh     → http://127.0.0.1:8000 (updates Supabase, same as production)
# 3. Optional isolated sandbox: LOCAL_USE_SQLITE=1 ./scripts/dev.sh

# Run bundled seed after startup (background). dev.sh defaults to false locally.
# Keep false for fast cold starts — use Monitor admin actions to load/sync data.
STARTUP_SEED=false

# Persist API/slow-query metrics to DB (Render: true). dev.sh defaults to false.
PERSIST_OBSERVABILITY=false

# Mobile app (Expo) — backend URL, no trailing slash
# Production: https://your-app.onrender.com
# Local phone on same Wi‑Fi: http://YOUR_LAN_IP:8000
EXPO_PUBLIC_API_URL=https://fifa-wc2026-s9xv.onrender.com

# Top players per nation loaded from Kaggle CSV (default 30)
# FC26_SQUAD_SIZE=30

# Kaggle FC26 player data — https://www.kaggle.com/datasets/rovnez/fc-26-fifa-26-player-data
# Bundled at data/seeds/fc26_players.csv. Optional: refresh from Kaggle API:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Regional boosts for WC 2026 neutral venues (see src/tournament.py)
# HOST_REGION_BOOST=0.05
# SOUTH_AMERICA_BOOST=0.05

# Admin password for pipeline/sync actions (set a strong value in production)
ADMIN_PASSWORD=

# Supabase Storage — persist trained ML models across Render redeploys
# Create a public "models" bucket in Supabase Storage (see DEPLOY.md)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App version / commit shown on Monitor page
APP_VERSION=2.1.0
# GIT_COMMIT=auto-set on Render via RENDER_GIT_COMMIT
