# Supabase Postgres
# Render: Supabase → Connect → Shared Pooler → Transaction (6543)
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# SQLite fallback (used when DATABASE_URL is empty)
DB_PATH=data/football.db

# API-Football v3 — https://www.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# football-data.org — https://www.football-data.org/
FOOTBALL_DATA_KEY=your_football_data_key_here

# Without API keys: python scripts/feed_data.py  or  POST /seed
LEAGUE_ID=1
SEASON=2026
FOOTBALL_DATA_COMPETITION_ID=2000

# Render: true | Local dev: false
ENABLE_SCHEDULER=false

# Run bundled seed after startup (background). Set false to skip on deploy.
STARTUP_SEED=true

# Mobile app (Expo) — backend URL, no trailing slash
EXPO_PUBLIC_API_URL=https://fifa-wc2026-s9xv.onrender.com

# Top players per nation loaded from Kaggle CSV (default 30)
# FC26_SQUAD_SIZE=30

# Kaggle FC26 player data — https://www.kaggle.com/datasets/rovnez/fc-26-fifa-26-player-data
# Bundled at data/seeds/fc26_players.csv. Optional: refresh from Kaggle API:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Regional boosts for WC 2026 neutral venues (see src/tournament.py)
# HOST_REGION_BOOST=0.05
# SOUTH_AMERICA_BOOST=0.05

# Admin password for pipeline/sync actions (set a strong value in production)
ADMIN_PASSWORD=

# App version / commit shown on Monitor page
APP_VERSION=2.1.0
# GIT_COMMIT=auto-set on Render via RENDER_GIT_COMMIT
