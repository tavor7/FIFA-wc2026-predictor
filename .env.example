# Supabase Postgres
# Render: Supabase → Connect → Shared Pooler → Transaction (6543) — NOT Dedicated Pooler (IPv6, fails on Render)
# Local Mac: Dedicated Pooler (db.xxxx.supabase.co:6543) also works
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Local SQLite fallback (used when DATABASE_URL is empty)
DB_PATH=data/football.db

# API-Football v3 (primary) - https://www.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# football-data.org (fallback) - https://www.football-data.org/
FOOTBALL_DATA_KEY=your_football_data_key_here

LEAGUE_ID=1
SEASON=2026
FOOTBALL_DATA_COMPETITION_ID=2000
